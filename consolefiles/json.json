		{
			"name": "Login_user1",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"console.log(\"Executing Pre-request Script...\");\r",
							"\r",
							"function getAuthToken() {\r",
							"    let authToken = pm.collectionVariables.get(\"auth2\");\r",
							"    let refreshToken = pm.collectionVariables.get(\"refresh2\");\r",
							"\r",
							"    if (authToken && refreshToken) {\r",
							"        console.log(\"Using existing tokens:\");\r",
							"        return { authToken, refreshToken };\r",
							"    } else {\r",
							"        console.log(\"Tokens not found. Requesting new ones...\");\r",
							"\r",
							"        // Asynchronous token request\r",
							"        pm.sendRequest({\r",
							"            url: 'https://example.com/api/auth', // 🔁 Update this\r",
							"            method: 'POST',\r",
							"            header: {\r",
							"                'Content-Type': 'application/json'\r",
							"            },\r",
							"            body: {\r",
							"                mode: 'raw',\r",
							"                raw: JSON.stringify({\r",
							"                    username: pm.environment.get(\"username2\"),\r",
							"                    password: pm.environment.get(\"password2\")\r",
							"                })\r",
							"            }\r",
							"        }, function (err, response) {\r",
							"            if (err) {\r",
							"                console.error(\"Error fetching tokens:\", err);\r",
							"                return;\r",
							"            }\r",
							"\r",
							"            if (response.code === 200) {\r",
							"                const data = response.json();\r",
							"                const newAuthToken = data.access_token;\r",
							"                const newRefreshToken = data.refresh_token;\r",
							"\r",
							"                pm.collectionVariables.set(\"auth2\", newAuthToken);\r",
							"                pm.collectionVariables.set(\"refresh2\", newRefreshToken);\r",
							"\r",
							"                console.log(\"New tokens set.\");\r",
							"                pm.request.headers.add({ key: \"Authorization\", value: `Bearer ${newAuthToken}` });\r",
							"            } else {\r",
							"                console.error(\"Token request failed with status:\", response.code);\r",
							"            }\r",
							"        });\r",
							"\r",
							"        return {}; // Tokens not ready immediately due to async call\r",
							"    }\r",
							"}\r",
							"\r",
							"// Get tokens (won't work reliably for async fetch above)\r",
							"const tokens = getAuthToken();\r",
							"if (tokens.authToken) {\r",
							"    pm.request.headers.add({ key: \"Authorization\", value: `Bearer ${tokens.authToken}` });\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let responseBody = pm.response.json();\r",
							"\r",
							"if (responseBody) {\r",
							"    console.log(\"Parsed JSON Response:\", JSON.stringify(responseBody));\r",
							"\r",
							"    const accessToken = responseBody.access_token;\r",
							"    const refreshToken = responseBody.refresh_token;\r",
							"    const idToken = responseBody.id_token;\r",
							"\r",
							"    if (accessToken) {\r",
							"        pm.collectionVariables.set(\"auth2\", accessToken);  // Used in Auth Header\r",
							"        console.log(\"Access Token set:\", accessToken);\r",
							"    }\r",
							"\r",
							"    if (refreshToken) {\r",
							"        pm.collectionVariables.set(\"refresh2\", refreshToken);\r",
							"        console.log(\"Refresh Token set:\", refreshToken);\r",
							"    }\r",
							"\r",
							"    if (idToken) {\r",
							"        pm.environment.set(\"id_token\", idToken);\r",
							"        console.log(\"ID Token set:\", idToken);\r",
							"    }\r",
							"\r",
							"    // Validations\r",
							"    pm.test(\"Status code is 200\", function () {\r",
							"        pm.response.to.have.status(200);\r",
							"    });\r",
							"\r",
							"    pm.test(\"Response time is acceptable\", function () {\r",
							"        pm.expect(pm.response.responseTime).to.be.below(1000);\r",
							"    });\r",
							"\r",
							"    pm.test(\"Required fields exist\", function () {\r",
							"        pm.expect(responseBody).to.have.property('access_token');\r",
							"        pm.expect(responseBody).to.have.property('refresh_token');\r",
							"        pm.expect(responseBody).to.have.property('id_token');\r",
							"    });\r",
							"\r",
							"} else {\r",
							"    console.error(\"Failed to parse response body.\");\r",
							"    pm.test(\"Login failed: Invalid response body\", function () {\r",
							"        pm.expect.fail(\"Login failed: response body is empty or not JSON\");\r",
							"    });\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
